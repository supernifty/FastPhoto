# At least one API key is required. Get yours from:
# Anthropic: https://console.anthropic.com/
# OpenAI: https://platform.openai.com/api-keys
# DashScope (Qwen): https://dashscope.console.aliyun.com/

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=

# Set to "false" to allow browsing outside your home directory
FASTPHOTO_RESTRICT_HOME=true

# Set to "false" to allow serving photos from outside the current directory
FASTPHOTO_RESTRICT_CWD=true
